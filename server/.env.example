# Required: privileged server-side Supabase access. Never expose SUPABASE_KEY
# through a client-side VITE_* variable.
SUPABASE_URL=
SUPABASE_KEY=

# Required: protects POST /api/v1/transactions.
EXTERNAL_API_KEY=

# Required: protects POST /api/internal/jobs/process-due-loans.
LOAN_JOB_SECRET=

# Optional: enables Rebrickable LEGO metadata lookup.
REBRICKABLE_API_KEY=

# Optional: Express listen port. Defaults to 5050.
PORT=5050

# Optional APY-03 adapter; disabled until separately authorized rollout and probe.
# Migration 036 must exist in the TARGET database. Repository presence is not proof.
APPLE_PAY_INGESTION_ENABLED=false
# SHA-256 hex digest of a dedicated ftapy1_<32 random bytes as base64url> credential.
# Never use SUPABASE_KEY, EXTERNAL_API_KEY or a scheduler secret here.
APPLE_PAY_TOKEN_SHA256=
# Optional previous digest during a short rotation overlap; same source identity.
APPLE_PAY_PREVIOUS_TOKEN_SHA256=
# Bounded JSON, no secret/full PAN/device account number. Real mappings must come
# from owner setup. Stable request_key is an audited configuration receipt.
# Preferred: one credential/source bound to one payment source; no client card label.
# APPLE_PAY_SOURCE_CONFIG={"instance_key":"owner-iphone","request_key":"<uuid>","payment_source_id":"<existing ID>","time_verified":false}
# Legacy explicit card_mappings mode remains supported; never combine both modes.
APPLE_PAY_SOURCE_CONFIG=

# Optional FLI-02 owner authorization: strict JSON array of 1-10 approved Supabase
# user UUIDs. Missing/empty/malformed disables ALL FlowLink APIs. Never use emails.
# FLOWLINK_OWNER_USER_IDS=["<approved Supabase user UUID>"]
FLOWLINK_OWNER_USER_IDS=
# FLI-02 provides enrollment/status only; status reports ingestion_enabled=false.
# No device plaintext credential or credential hash belongs in environment config.
