# Backend-only allowlist. Never package local settings, artifacts or owner data.
**
!server/
server/*
!server/package.json
!server/package-lock.json
!server/index.js
!server/config/
!server/config/*.js
!server/controllers/
!server/controllers/*.js
!server/middleware/
!server/middleware/*.js
!server/routes/
!server/routes/*.js
!server/services/
!server/services/*.js
!server/utils/
!server/utils/*.js
# Shopping runtime only. No colocated tests, fixtures or private evidence.
!server/modules/
server/modules/*
!server/modules/shopping/
server/modules/shopping/*
!server/modules/shopping/categories/
server/modules/shopping/categories/*
!server/modules/shopping/categories/*.js
!server/modules/shopping/catalog/
server/modules/shopping/catalog/*
!server/modules/shopping/catalog/*.js
!server/modules/shopping/list-types/
server/modules/shopping/list-types/*
!server/modules/shopping/list-types/*.js
!server/modules/shopping/shared/
server/modules/shopping/shared/*
!server/modules/shopping/shared/*.js
!server/modules/shopping/http/
server/modules/shopping/http/*
!server/modules/shopping/http/*.js
!server/modules/shopping/lists/
server/modules/shopping/lists/*
!server/modules/shopping/lists/*.js
!server/modules/shopping/receipts/
server/modules/shopping/receipts/*
!server/modules/shopping/receipts/*.js
!server/modules/shopping/intelligence/
server/modules/shopping/intelligence/*
!server/modules/shopping/intelligence/*.js
server/modules/shopping/**/*.test.js
server/modules/shopping/**/fixtures/**
!shared/
shared/*
!shared/*.mjs
**/.env*
**/*.env*
**/node_modules
**/__pycache__
**/*.log
