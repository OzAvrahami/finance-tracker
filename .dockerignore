# Backend-only allowlist. Never package local settings, artifacts or owner data.
**
!server/
server/*
!server/package.json
!server/package-lock.json
!server/index.js
!server/config/
!server/config/*.js
!server/controllers/
!server/controllers/*.js
!server/middleware/
!server/middleware/*.js
!server/routes/
!server/routes/*.js
!server/services/
!server/services/*.js
!server/utils/
!server/utils/*.js
!shared/
shared/*
!shared/*.mjs
**/.env*
**/*.env*
**/node_modules
**/__pycache__
**/*.log
